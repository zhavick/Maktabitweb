# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maktabit_web

# Payload CMS Secret (min. 32 karakter acak untuk produksi)
PAYLOAD_SECRET=replace-with-a-long-random-secret-key

# URL Publik Website
NEXT_PUBLIC_SITE_URL=http://localhost:3390

